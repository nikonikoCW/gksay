{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GkSay",
  "version": "0.1.2",
  "identifier": "com.gksay.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GkSay",
        "width": 680,
        "height": 620,
        "minWidth": 520,
        "minHeight": 570,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
